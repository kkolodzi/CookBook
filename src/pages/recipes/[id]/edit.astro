---
import Layout from "@/layouts/Layout.astro";
import RecipeEditForm from "@/components/recipes/RecipeEditForm";
import { createClient } from "@/lib/supabase";
import type { RecipeTypeValue } from "@/components/recipes/recipe-type-labels";

const { id } = Astro.params;

let recipe: {
  id: string;
  name: string;
  type: RecipeTypeValue;
  ingredients: string[];
  instructions: string | null;
} | null = null;
let loadError: string | null = null;

const supabase = id ? createClient(Astro.request.headers, Astro.cookies) : null;
if (id && !supabase) {
  loadError = "Usługa jest tymczasowo niedostępna.";
} else if (id && supabase) {
  const { data: recipeRow, error: recipeError } = await supabase
    .from("recipes")
    .select("id, name, type, instructions")
    .eq("id", id)
    .is("deleted_at", null)
    .single();

  if (!recipeError) {
    const { data: ingredientRows } = await supabase
      .from("recipe_ingredients")
      .select("name")
      .eq("recipe_id", id)
      .order("position", { ascending: true });

    recipe = {
      id: recipeRow.id,
      name: recipeRow.name,
      type: recipeRow.type,
      ingredients: (ingredientRows ?? []).map((i) => i.name),
      instructions: recipeRow.instructions,
    };
  }
}

if (!recipe && !loadError) {
  Astro.response.status = 404;
}
---

<Layout title={recipe ? `Edytuj: ${recipe.name}` : "Nie znaleziono przepisu"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 backdrop-blur-xl">
      {
        loadError ? (
          <p class="text-sm text-red-300">{loadError}</p>
        ) : !recipe ? (
          <div class="space-y-4 text-center text-white">
            <p>Nie znaleziono przepisu.</p>
            <a href="/recipes" class="text-sm text-blue-100/70 underline hover:text-white">
              ← Wróć do listy przepisów
            </a>
          </div>
        ) : (
          <>
            <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
              Edytuj przepis
            </h1>
            <RecipeEditForm client:load recipe={recipe} />
            <a
              href={`/recipes/${recipe.id}`}
              class="mt-6 inline-block text-sm text-blue-100/70 underline hover:text-white"
            >
              ← Wróć do przepisu
            </a>
          </>
        )
      }
    </div>
  </div>
</Layout>
